generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  UserID            String             @id @default(cuid())
  FullName          String?
  Email             String             @unique
  Password          String?
  Role              Role               @default(STUDENT)
  DateCreated       DateTime           @default(now())
  emailVerified     DateTime?
  image             String?
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  adminLogs         AdminLog[]
  attendanceMarked  Attendance[]       @relation("InstructorMarksAttendance")
  attendanceRecords Attendance[]       @relation("StudentAttendance")
  cohortMemberships CohortMembership[]
  gradesFinalized   Grade[]            @relation("InstructorFinalizesGrades")
  sessions          Session[]
  submissions       Submission[]       @relation("StudentSubmissions")
  answersGraded     SubmissionAnswer[] @relation("InstructorGradesAnswers")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [UserID], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [UserID], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cohort {
  CohortID     String             @id @default(cuid())
  CohortName   String
  AcademicYear String
  Description  String?
  assignments  Assignment[]
  memberships  CohortMembership[]
  courses      Course[]
}

model CohortMembership {
  MembershipID String           @id @default(cuid())
  UserID       String
  CohortID     String
  Status       MembershipStatus @default(ACTIVE)
  DateJoined   DateTime         @default(now())
  cohort       Cohort           @relation(fields: [CohortID], references: [CohortID], onDelete: Cascade)
  user         User             @relation(fields: [UserID], references: [UserID], onDelete: Cascade)

  @@unique([UserID, CohortID])
}

model Course {
  CourseID    String   @id @default(cuid())
  CohortID    String
  Title       String
  Description String?
  cohort      Cohort   @relation(fields: [CohortID], references: [CohortID], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  LessonID      String        @id @default(cuid())
  CourseID      String
  Title         String
  SequenceOrder Int
  DateCreated   DateTime      @default(now())
  assignments   Assignment[]
  attendance    Attendance[]
  audio         Audio?
  course        Course        @relation(fields: [CourseID], references: [CourseID], onDelete: Cascade)
  notes         Note[]
  video         Video?
  zoomMeetings  ZoomMeeting[]
}

model Video {
  VideoID         String @id @default(cuid())
  LessonID        String @unique
  Title           String
  YoutubeLink     String
  DurationSeconds Int?
  lesson          Lesson @relation(fields: [LessonID], references: [LessonID], onDelete: Cascade)
}

model Audio {
  AudioID         String @id @default(cuid())
  LessonID        String @unique
  Title           String
  AudioLink       String
  DurationSeconds Int?
  lesson          Lesson @relation(fields: [LessonID], references: [LessonID], onDelete: Cascade)
}

model ZoomMeeting {
  MeetingID     String   @id @default(cuid())
  LessonID      String
  Title         String
  MeetingLink   String?
  RecordingLink String?
  MeetingDate   DateTime
  lesson        Lesson   @relation(fields: [LessonID], references: [LessonID], onDelete: Cascade)
}

model Note {
  NoteID   String  @id @default(cuid())
  LessonID String
  Title    String
  Content  String?
  FileLink String?
  lesson   Lesson  @relation(fields: [LessonID], references: [LessonID], onDelete: Cascade)
}

model Assignment {
  AssignmentID String       @id @default(cuid())
  LessonID     String
  CohortID     String
  Title        String
  Description  String?
  DeadlineDate DateTime
  MaxScore     Float?
  cohort       Cohort       @relation(fields: [CohortID], references: [CohortID], onDelete: Cascade)
  lesson       Lesson       @relation(fields: [LessonID], references: [LessonID], onDelete: Cascade)
  questions    Question[]
  submissions  Submission[]
}

model Question {
  QuestionID    String             @id @default(cuid())
  AssignmentID  String
  QuestionText  String
  SequenceOrder Int
  QuestionType  QuestionType       @default(SHORT_ANSWER)
  MaxScore      Float
  assignment    Assignment         @relation(fields: [AssignmentID], references: [AssignmentID], onDelete: Cascade)
  answers       SubmissionAnswer[]
}

model Submission {
  SubmissionID String             @id @default(cuid())
  AssignmentID String
  StudentID    String
  SubmittedAt  DateTime?
  Status       SubmissionStatus   @default(DRAFT)
  ReceiptCode  String?            @unique
  attachments  Attachment[]
  grade        Grade?
  assignment   Assignment         @relation(fields: [AssignmentID], references: [AssignmentID], onDelete: Cascade)
  student      User               @relation("StudentSubmissions", fields: [StudentID], references: [UserID], onDelete: Cascade)
  answers      SubmissionAnswer[]

  @@unique([AssignmentID, StudentID])
}

model SubmissionAnswer {
  AnswerID     String     @id @default(cuid())
  SubmissionID String
  QuestionID   String
  AnswerText   String?
  ScoreAwarded Float?
  Feedback     String?
  GradedByID   String?
  GradedAt     DateTime?
  gradedBy     User?      @relation("InstructorGradesAnswers", fields: [GradedByID], references: [UserID])
  question     Question   @relation(fields: [QuestionID], references: [QuestionID], onDelete: Cascade)
  submission   Submission @relation(fields: [SubmissionID], references: [SubmissionID], onDelete: Cascade)

  @@unique([SubmissionID, QuestionID])
}

model Attachment {
  AttachmentID String     @id @default(cuid())
  SubmissionID String
  FileName     String
  FileLink     String
  FileSizeKB   Int?
  DateUploaded DateTime   @default(now())
  submission   Submission @relation(fields: [SubmissionID], references: [SubmissionID], onDelete: Cascade)
}

model Grade {
  GradeID          String      @id @default(cuid())
  SubmissionID     String      @unique
  FinalizedByID    String?
  TotalScore       Float?
  MaxPossibleScore Float?
  OverallFeedback  String?
  Status           GradeStatus @default(PENDING)
  FinalizedAt      DateTime?
  finalizedBy      User?       @relation("InstructorFinalizesGrades", fields: [FinalizedByID], references: [UserID])
  submission       Submission  @relation(fields: [SubmissionID], references: [SubmissionID], onDelete: Cascade)
}

model Attendance {
  AttendanceID String           @id @default(cuid())
  UserID       String
  LessonID     String
  Status       AttendanceStatus
  MarkedByID   String?
  MarkedAt     DateTime         @default(now())
  lesson       Lesson           @relation(fields: [LessonID], references: [LessonID], onDelete: Cascade)
  markedBy     User?            @relation("InstructorMarksAttendance", fields: [MarkedByID], references: [UserID])
  user         User             @relation("StudentAttendance", fields: [UserID], references: [UserID], onDelete: Cascade)

  @@unique([UserID, LessonID])
}

model AdminLog {
  LogID      String   @id @default(cuid())
  AdminID    String
  Action     String
  TargetType String
  TargetID   String
  Timestamp  DateTime @default(now())
  admin      User     @relation(fields: [AdminID], references: [UserID], onDelete: Cascade)
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum QuestionType {
  SHORT_ANSWER
  ESSAY
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
}

enum GradeStatus {
  PENDING
  COMPLETE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}
